# Sao chép thành .env rồi dùng: copy .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore). Đây chỉ là giá trị dev cục bộ.

# PostgreSQL
POSTGRES_USER=doc2pdf
POSTGRES_PASSWORD=doc2pdf_dev_password
POSTGRES_DB=doc2pdf
POSTGRES_PORT=5432
DATABASE_URL=postgresql://doc2pdf:doc2pdf_dev_password@localhost:5432/doc2pdf

# S3 cục bộ (SeaweedFS, tương thích S3)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET_SOURCES=sources
S3_BUCKET_RESULTS=results

# RabbitMQ (giả hàng đợi)
RABBITMQ_USER=doc2pdf
RABBITMQ_PASSWORD=doc2pdf_dev_password
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://doc2pdf:doc2pdf_dev_password@localhost:5672/

# Giới hạn ứng dụng (theo đề)
MAX_UPLOAD_MB=10